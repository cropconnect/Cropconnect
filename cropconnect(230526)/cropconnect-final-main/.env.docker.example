# Copy this to .env.docker and fill in your local values.
# Never commit .env.docker — it is already in .gitignore.

MYSQL_ROOT_PASSWORD=change-me-locally
MYSQL_PASSWORD=change-me-locally
MYSQL_DATABASE=cropconnect
MYSQL_USER=cropconnect
MYSQL_HOST=db
MYSQL_PORT=3306

CROP_DATA_SECRET_KEY=replace-with-a-long-random-secret
CROP_AUTH_TOKEN_SECRET=replace-with-a-different-long-random-secret
ESP32_API_KEY=replace-with-your-esp32-api-key

FRONTEND_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
